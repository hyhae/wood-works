{
  "name": "woodwork-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run optimize:images && vite dev --host 127.0.0.1",
    "build": "npm run validate:content && npm run optimize:images && vite build",
    "optimize:images": "node scripts/optimize-images.ts",
    "import:content": "node scripts/import-content.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "validate:content": "node scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@tabler/icons-svelte": "^3.49.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@playwright/test": "^1.64.0",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.4",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
